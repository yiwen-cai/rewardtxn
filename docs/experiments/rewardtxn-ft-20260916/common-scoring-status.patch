diff --git a/areal/utils/strict_reward.py b/areal/utils/strict_reward.py
new file mode 100644
index 0000000..c390b21
--- /dev/null
+++ b/areal/utils/strict_reward.py
@@ -0,0 +1,97 @@
+"""Bounded per-call processes for strict scoring; shared by A and A+R.
+
+Only the score worker for this invocation is terminated on timeout. This does
+not kill shared legacy ProcessPoolExecutor workers or other in-flight samples.
+"""
+import asyncio
+import hashlib
+import json
+import math
+import multiprocessing
+import os
+import time
+
+from areal.utils import logging
+from areal.utils.reward_status import RewardEvaluationError, ScoringFailure
+
+logger = logging.getLogger("StrictReward")
+
+
+def _worker(channel, scorer, args, kwargs):
+    try:
+        try:
+            value = scorer(*args, **kwargs)
+            score = getattr(value, "score", value)
+            if type(score) not in (int, float) or not math.isfinite(score) or score not in (0, 1):
+                raise ScoringFailure("error", "strict scorer returned an invalid score")
+            packet = {"status": "scored", "value": value}
+        except ScoringFailure as exc:
+            packet = {"status": exc.status, "detail": exc.detail}
+        except Exception as exc:
+            packet = {"status": "error", "detail": type(exc).__name__}
+        channel.send(packet)
+    finally:
+        channel.close()
+        # No inherited executor/atexit cleanup in this forked score worker.
+        os._exit(0)
+
+
+async def evaluate(scorer, args, kwargs, timeout, retries):
+    # JSON inputs match the RLVR reward API; omit R's additional envelope.
+    binding = [args, {k: v for k, v in sorted(kwargs.items()) if k != "_r_reward_request"}]
+    input_hash = hashlib.sha256(json.dumps(binding, sort_keys=True).encode()).hexdigest()
+    attempts = []
+    for number in range(retries + 1):
+        ctx = multiprocessing.get_context("fork")
+        reader, writer = ctx.Pipe(duplex=False)
+        process = ctx.Process(target=_worker, args=(writer, scorer, args, kwargs))
+        started = time.monotonic()
+        packet = {"status": "error", "detail": "worker exited without a result"}
+        try:
+            process.start()
+            writer.close()
+            while not reader.poll():
+                if time.monotonic() - started >= timeout:
+                    packet = {"status": "timeout", "detail": "scoring deadline exceeded"}
+                    break
+                if not process.is_alive():
+                    break
+                await asyncio.sleep(0.01)
+            else:
+                try:
+                    packet = reader.recv()
+                except EOFError:
+                    pass
+        finally:
+            writer.close()
+            reader.close()
+            # Also clean up when the caller is cancelled. Never leave a score
+            # process alive after retry, return, or terminal failure.
+            # A short bounded synchronous cleanup cannot be interrupted by a
+            # second Task.cancel(). It also releases the Process sentinel fd.
+            pid = process.pid
+            if pid is not None:
+                process.join(timeout=0.02 if packet["status"] == "scored" else 0)
+                if process.is_alive():
+                    process.terminate()
+                    process.join(timeout=0.2)
+                    if process.is_alive():
+                        process.kill()
+                        process.join(timeout=1)
+                if process.is_alive():
+                    raise RuntimeError("score worker could not be reaped")
+            exit_code = process.exitcode
+            process.close()
+        if packet['status'] == 'scored' and exit_code != 0:
+            packet = {'status': 'error', 'detail': 'worker did not exit cleanly'}
+        record = {"attempt": number + 1, "input_sha256": input_hash,
+                  "pid": pid, "status": packet["status"],
+                  "detail": packet.get("detail"), "exit_code": exit_code,
+                  "elapsed_seconds": time.monotonic() - started}
+        attempts.append(record)
+        logger.info("scoring_attempt %s", json.dumps(record, sort_keys=True))
+        if packet["status"] == "scored":
+            return packet["value"]
+        if packet["status"] == "invalid_gold":
+            break
+    raise RewardEvaluationError(attempts)
diff --git a/areal/utils/reward_status.py b/areal/utils/reward_status.py
new file mode 100644
index 0000000..2baa72f
--- /dev/null
+++ b/areal/utils/reward_status.py
@@ -0,0 +1,17 @@
+"""Explicit failures for the common strict scoring path."""
+
+
+class ScoringFailure(Exception):
+    def __init__(self, status: str, detail: str):
+        super().__init__(status, detail)
+        self.status = status
+        self.detail = detail
+
+
+class RewardEvaluationError(Exception):
+    """Terminal scoring failure: the rollout must not be silently replaced."""
+
+    def __init__(self, attempts: list[dict]):
+        super().__init__(attempts)
+        self.attempts = attempts
+
