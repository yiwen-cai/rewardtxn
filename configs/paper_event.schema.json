{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rewardtxn/paper-event-line/1.0",
  "title": "RewardTxn paper-eval events.jsonl 行 schema",
  "description": "§10 数据契约：每个 run 的 events.jsonl 每行必须满足本 schema。type 覆盖 group / reward / queue / learner / checkpoint / ack / recovery / fault 八类时间线事件。",
  "type": "object",
  "required": ["type", "ts", "exp_id"],
  "properties": {
    "type": {
      "enum": ["group", "reward", "queue", "learner", "checkpoint", "ack", "recovery", "fault"]
    },
    "ts": { "type": "number", "description": "epoch 秒（float）" },
    "exp_id": { "type": "string", "minLength": 1 },
    "step": { "type": "integer", "minimum": 0 },
    "group_ids": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "description": "受影响组（全局 group_index）"
    },
    "attempt": { "type": "integer", "minimum": 0, "description": "attempt/epoch 编号" },
    "verifier_digest": { "type": "string", "description": "verifier 版本/digest（如 v1/v2 或镜像 digest）" },
    "checkpoint_hash": { "type": ["string", "null"] },
    "step_token": { "type": ["string", "null"], "description": "StepToken 或 null" },
    "cut": {
      "type": "string",
      "enum": ["R1", "R2", "R3", "R4", "R5", "Q0", "Q1", "L0", "L2", "L3", "C1", "C2"]
    },
    "trial": { "type": "integer", "minimum": 0 },
    "schedule_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "logical_id": { "type": ["string", "null"] },
    "exit_code": { "type": "integer", "description": "进程退出码（fault/learner 事件）" },
    "recovery_decision": {
      "type": "string",
      "enum": ["replay", "reissue", "rollback", "cold_start", "commit_ack", "none"]
    },
    "oracle_verdict": { "enum": ["PASS", "FAIL", null] },
    "payload": {
      "type": "object",
      "description": "类型特有负载：revision 向量、rewards、丢失样本数、恢复计划等"
    }
  },
  "allOf": [
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "group" } } },
      "then": { "required": ["group_ids"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "checkpoint" } } },
      "then": { "required": ["checkpoint_hash", "step_token", "step"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "recovery" } } },
      "then": { "required": ["recovery_decision"] }
    }
  ],
  "additionalProperties": true
}
